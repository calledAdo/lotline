# Copy to .env and fill in. Never commit .env.
SAMPLE_MODE=false

# Zetaris (local Docker install)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
# Setup only; runtime agents never use this administrator key.
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift runtime (from Nightshift > Console)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_APP_ID=lotline
METERLESS_FAST_MODE=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_DEEP_MODE=nvidia/nemotron-3-ultra-550b-a55b

# Lotline's local sources (infra/docker-compose.yml). Replace all placeholders locally.
HOSPITAL_DB_USER=lotline
HOSPITAL_DB_PASSWORD=change-me
S3_ACCESS_KEY=your-local-s3-access-key
S3_SECRET_KEY=change-me-too
LOTLINE_BUCKET=lotline

# npm run setup:zetaris generates local test credentials for missing placeholders.
# Runtime: Basic login -> in-memory idToken, or an optional per-user API_KEY.
ZETARIS_CARTOGRAPHER_USER=your-cartographer-user
ZETARIS_CARTOGRAPHER_PASSWORD=your-cartographer-password
# ZETARIS_CARTOGRAPHER_API_KEY=your-cartographer-api-key
ZETARIS_PLANNER_USER=your-planner-user
ZETARIS_PLANNER_PASSWORD=your-planner-password
# ZETARIS_PLANNER_API_KEY=your-planner-api-key
ZETARIS_EXPOSURE_USER=your-exposure-user
ZETARIS_EXPOSURE_PASSWORD=your-exposure-password
# ZETARIS_EXPOSURE_API_KEY=your-exposure-api-key
ZETARIS_SUPPLY_USER=your-supply-user
ZETARIS_SUPPLY_PASSWORD=your-supply-password
# ZETARIS_SUPPLY_API_KEY=your-supply-api-key
ZETARIS_WATCHER_USER=your-watcher-user
ZETARIS_WATCHER_PASSWORD=your-watcher-password
# ZETARIS_WATCHER_API_KEY=your-watcher-api-key
